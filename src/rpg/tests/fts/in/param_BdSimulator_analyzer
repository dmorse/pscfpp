BdSimulator{
   LMBdStep{
      mobility        1.0E-3
   }
   LrAmCompressor{
      epsilon      1.0e-4
      maxItr       200
      maxHist      30
      verbose	   0
      errorType    rmsResid
   }
   EinsteinCrystalPerturbation{
      lambda 0.25
      fieldFileName  in/w_dis_3D_homogenous.rf
   }
   AnalyzerManager{
      baseInterval    1
      CubicLengthDerivative{
         interval        1
         outputFileName  out/cubicLengthDerivative
      }
      PerturbationDerivative{
         interval        1
         outputFileName  out/perturbationDerivative
      }
      MaxOrderParameter{
         interval        1
         outputFileName  out/maxOrder
      }
      FourthOrderParameter{
         interval        1
         outputFileName  out/fourthOrder
      }
      ConcentrationDerivative{
         interval        1
         outputFileName  out/concentrationDerivative
      }
      BinaryChiDerivative{
         interval        1
         outputFileName  out/chiDerivative
      }
      BinaryStructureFactor{
         interval        1
         outputFileName  out/binaryStructureFactor
         writeWaveData   1
      }
      HamiltonianAnalyzer{
         interval        1
         outputFileName  out/hamiltonian
         nSamplePerOutput 1
      }
      TrajectoryWriter{
         interval        1
         outputFileName  out/trajectory
      }
      StepLogger{
         interval        5
      }
   }
}
