namespace Pscf {

   /**
   * Code for programs that simulate real-valued periodic fields.
   */ 
   namespace Rp {
   
      /**
      * \defgroup Pscf_Rp_Module Pscf::Rp - Real Periodic Fields 
      *
      * Class templates for use SCFT and PS-FTS with real fields.
      *
      * The Pscf::Rp namespace contains class templates that implement
      * SCFT and PS-FTS calculations for real-valued periodic fields. 
      * This namespace contains a set of class templates that each take 
      * the dimension of space D and a backend type class as parameters.
      * Specializations of these templates with T=CPT and T=CPT are used
      * to construct the pscf_rpc and pscf_rpg programs, respectively.
      *
      * \ingroup Pscf_NS_Module
      */
   
   }

}
