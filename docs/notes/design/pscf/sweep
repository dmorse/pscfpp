   void reset() override;
      Calls State::setSystemState(isFlexible)
      Comment: Depends on implementation of state class
      Proposal: Move to SweepTmpl or subclass thereof

   void cleanup() override;
       Closes log file
       Proposal: Keep in Sweep base class

