#!/usr/bin/env python3

from pscfpp.output import *
import io

# Read a Thermo object from text
def readThermo(text):
   t = Thermo()
   t.read(io.StringIO(text))
   return t

thermo = '''
fHelmholtz     2.54644869605e+00
pressure       2.99799018142e+00

fIdeal         5.48458514628e-01
fInter         1.99799018143e+00

polymers:
             phi                 mu
    0   1.00000000000e+00   5.54443887748e+00

cellParams:
    0   1.54046133979e+00
    1   1.60000000000e+00

'''

# An environment-modified stress listed only for lattice parameter 1
t = readThermo(thermo + '''environment-modified stress:
    1   2.50000000000e-03

''')
assert t.environmentStress == [None, 2.5e-3]
assert readThermo(str(t)).environmentStress == [None, 2.5e-3]
