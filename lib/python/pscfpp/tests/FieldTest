#!/usr/bin/env python3

from pscfpp.field import *
import os, tempfile

# Header of an r-grid or k-grid file for a 1D system with two monomer
# types on a mesh of 4 points, without a group_name
header = '''format   1   0
dim
          1
crystal_system
          lamellar
N_cell_param
          1
cell_param
      1.0000000000e+00
N_monomer
          2
mesh
          4
'''

# Read a Field from a file with the given text
def readText(text):
   with tempfile.TemporaryDirectory() as d:
      name = os.path.join(d, 'field')
      with open(name, 'w') as file:
         file.write(text)
      return Field(name)

# All rows of a file without a group_name
rows = [[0.1, 0.9], [0.2, 0.8], [0.3, 0.7], [0.4, 0.6]]
f = readText(header + ''.join(f'{a} {b}\n' for a, b in rows))
assert f.type == 'rgrid'
assert f.data == rows
assert list(f.header)[-1] == 'mesh' and f.header['mesh'] == [4]

# Files of pscf_1d with three header lines (WRITE_BLOCK_C) and with one
# header line and no grid point index (WRITE_Q_SLICE), read, written
# and read again
blockc = '''nx          3
n_block     2
n_solvent   1
    0  9.0e-01  5.0e-02  5.0e-02
    1  5.0e-01  4.0e-01  1.0e-01
    2  1.0e-01  8.5e-01  5.0e-02
'''
qslice = '''nx     3
   1.2e+00
   1.1e+00
   1.0e+00
'''
for text, values, nColumn in [(blockc, {'nx': 3, 'n_block': 2, 'n_solvent': 1}, 4),
                              (qslice, {'nx': 3}, 1)]:
   f = readText(text)
   g = readText(str(f))
   for h in [f, g]:
      assert h.type == 'fd1d'
      assert h.header == values
      assert len(h.data) == 3
      assert [len(row) for row in h.data] == [nColumn]*3
   assert g.data == f.data

# The format of a mesh field file is given by its number of columns:
# an r-grid file with integer values, and a k-grid file
f = readText(header + '1 0\n1 0\n0 1\n0 1\n')
assert f.type == 'rgrid'
assert readText(str(f)).data == f.data
f = readText(header + ''.join(f'{i} 0.5 0.0 0.5 0.0\n' for i in range(3)))
assert f.type == 'kgrid'

# A second read replaces the contents of the first
f = Field('in/w.bf')
with open('in/w.bf') as file:
   f.read(file)
assert len(f.data) == f.header['N_basis']

f = Field('in/w.bf')

print(f) 

print('Field type =' + str(f.type))

print('cell_param = ' + str(f.header['cell_param']))
print('N_basis    = ' + str(f.header['N_basis']))
print('len(data)  = ' + str(len(f.data)))

print('Setting cell_param value to 3.55')
f.header['cell_param'] = [3.55]

print(f.header)

f.addColumn(1, 1.5)
f.reorder([0, 2, 1, 3, 4, 5, 6])

print(f)


