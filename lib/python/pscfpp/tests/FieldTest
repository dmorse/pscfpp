#!/usr/bin/env python3

from pscfpp.field import *
import os, tempfile

# Header of an r-grid or k-grid file for a 1D system with two monomer
# types on a mesh of 4 points, without a group_name
header = '''format   1   0
dim
          1
crystal_system
          lamellar
N_cell_param
          1
cell_param
      1.0000000000e+00
N_monomer
          2
mesh
          4
'''

# Read a Field from a file with the given text
def readText(text):
   with tempfile.TemporaryDirectory() as d:
      name = os.path.join(d, 'field')
      with open(name, 'w') as file:
         file.write(text)
      return Field(name)

# All rows of a file without a group_name
rows = [[0.1, 0.9], [0.2, 0.8], [0.3, 0.7], [0.4, 0.6]]
f = readText(header + ''.join(f'{a} {b}\n' for a, b in rows))
assert f.type == 'rgrid'
assert f.data == rows
assert list(f.header)[-1] == 'mesh' and f.header['mesh'] == [4]

f = Field('in/w.bf')

print(f) 

print('Field type =' + str(f.type))

print('cell_param = ' + str(f.header['cell_param']))
print('N_basis    = ' + str(f.header['N_basis']))
print('len(data)  = ' + str(len(f.data)))

# Miller indices that fill their field width must be separate words
g = Field('in/w.bf')
g.data[1][2:5] = [-1000, 10000, -9999]
lines = str(g).splitlines()
words = lines[len(lines) - len(g.data) + 1].split()
assert words[2:] == ['-1000', '10000', '-9999', '24']

print('Setting cell_param value to 3.55')
f.header['cell_param'] = [3.55]

print(f.header)

f.addColumn(1, 1.5)
f.reorder([0, 2, 1, 3, 4, 5, 6])

print(f)


# Values with three-digit exponents must remain separate columns
import os, tempfile
f = Field('in/w.rf')
f.data[0] = [-1.5e-100, -2.5e-100]
with tempfile.TemporaryDirectory() as d:
   f.write(os.path.join(d, 'w.rf'))
   g = Field(os.path.join(d, 'w.rf'))
assert g.type == 'rgrid'
assert g.data[0] == [-1.5e-100, -2.5e-100]

f.type = 'kgrid'
f.data = [[i, -1.5e-100, -2.5e-100, -3.5e-100, -4.5e-100] for i in range(3)]
with tempfile.TemporaryDirectory() as d:
   f.write(os.path.join(d, 'w.kf'))
   g = Field(os.path.join(d, 'w.kf'))
assert g.type == 'kgrid'
assert g.data == f.data
