#!/usr/bin/env python3

from pscfpp.param import *
import os, tempfile

# Read a parameter file with the given text
def readText(text):
   with tempfile.TemporaryDirectory() as d:
      name = os.path.join(d, 'param')
      with open(name, 'w') as file:
         file.write(text)
      return Composite(name)

# An integer with an explicit sign
p = readText('System{\n  AmIterator{\n    maxItr  +200\n  }\n}\n')
assert p.AmIterator.maxItr == 200 and isinstance(p.AmIterator.maxItr, int)
