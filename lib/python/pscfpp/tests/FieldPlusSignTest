#!/usr/bin/env python3

from pscfpp.field import *
import os, tempfile

# Header of an r-grid or k-grid file for a 1D system with two monomer
# types on a mesh of 4 points
header = '''format   1   0
dim
          1
crystal_system
          lamellar
N_cell_param
          1
cell_param
      1.0000000000e+00
group_name
          P_-1
N_monomer
          2
mesh
          4
'''

# Read a Field from a file with the given text
def readText(text):
   with tempfile.TemporaryDirectory() as d:
      name = os.path.join(d, 'field')
      with open(name, 'w') as file:
         file.write(text)
      return Field(name)

# A k-grid index with an explicit sign
f = readText(header + ''.join(f'+{i} 0.5 0.0 0.5 0.0\n' for i in range(3)))
assert f.data[0][0] == 0 and isinstance(f.data[0][0], int)
