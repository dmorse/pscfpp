#!/usr/bin/env python3

from pscfpp.param import *
import os, tempfile

# Read a parameter file with the given text
def readText(text):
   with tempfile.TemporaryDirectory() as d:
      name = os.path.join(d, 'param')
      with open(name, 'w') as file:
         file.write(text)
      return Composite(name)

# Setting a whole matrix with a nonzero diagonal element
p = Composite('in/param')
p.Interaction.chi = [[1.0, 15.0], [15.0, 0.0]]
assert readText(str(p)).Interaction.chi == [[1.0, 15.0], [15.0, 0.0]]
