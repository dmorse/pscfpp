#!/usr/bin/env python3

from pscfpp.param import *
import os, tempfile

# Read a parameter file with the given text
def readText(text):
   with tempfile.TemporaryDirectory() as d:
      name = os.path.join(d, 'param')
      with open(name, 'w') as file:
         file.write(text)
      return Composite(name)

# Values of a parameter on one line that are wider than their columns
p = readText('System{\n  Polymer{\n    blocks  0  0.3333333\n  }\n}\n')
assert readText(str(p)).Polymer.blocks == [0, 0.3333333]
